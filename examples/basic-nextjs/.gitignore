# See https://help.github.com/ignore-files/ for more about ignoring files.

# dependencies
/node_modules

# next.js
/.next*/
/out/

# misc
.DS_Store

# local env files
.env.local
.env.*.local
.env

# Pi agent folder holds auth and sessions — commit only the generated project config
.pi/*
!.pi/settings.json
!.pi/mcp.json

# AI demo builder — never commit
docs/ai/config/credentials.local.yaml
docs/ai/demos/*/
docs/ai/themes/*/

# Content SDK reference clone (used by coding agents, not project code)
/content-sdk/

# Log files
*.log*

# vercel
.vercel

# sitecore temp files
.playwright-mcp/*
.screenshots/*
# except for component-map
!.sitecore/component-map.ts
!.sitecore/component-map.client.ts

# search verification artifacts and search-setup working records
.tmp-search-verify/
.search-setup/

# generated by Content SDK tools at build
.sitecore/metadata.json
.sitecore/sites.json

# generated by TypeScript (incremental) and Next.js (dev mode rewrites it); CI's
# tools/ci/prepare-typecheck.cjs creates the standard next-env.d.ts when missing
tsconfig.tsbuildinfo
next-env.d.ts

# test coverage output
/coverage
